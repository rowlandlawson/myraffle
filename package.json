{
  "name": "raffle-project-root",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "prepare": "husky install",
    "lint": "bunx biome check .",
    "lint:fix": "bunx biome check --fix --unsafe .",
    "format": "bunx biome format --write .",
    "ci:check": "bun --cwd raffle-backend prisma generate && bun --cwd raffle-app build"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.8.3",
    "husky": "^9.0.11"
  }
}
